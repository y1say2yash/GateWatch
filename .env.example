# Application
NODE_ENV=development

# Backend
BACKEND_PORT=4000

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_DB=gatewatch
POSTGRES_USER=gatewatch
# Set a non-empty local password before starting Docker Compose.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Demo APIs
ORDER_API_PORT=3001
PRODUCT_API_PORT=3002
USER_API_PORT=3003

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost/api/v1/auth/github/callback

# API testing and local upstream access
# Required in production. Locally required only to store or execute credentialed test definitions.
TEST_CREDENTIAL_ENCRYPTION_KEY=
# Exact comma-separated origins; honored only in development/test. Empty means no local/private targets.
TEST_LOCAL_ALLOWED_ORIGINS=http://product-api:3002,http://order-api:3001,http://user-api:3003